# Neon PostgreSQL (required on Vercel + local for registration API)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Canonical site URL for this build (no trailing slash preferred)
# Local:        http://localhost:3000
# Vercel:       https://adreach-psi.vercel.app
# Hostinger:    https://adreach.agency/seminar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional event slug (defaults to adreach-tiktok-seminar-2026)
NEXT_PUBLIC_EVENT_SLUG=adreach-tiktok-seminar-2026

# API origin only — no path. Required for Hostinger static builds.
# Leave unset for local + Vercel so the form posts to same-origin /api/register/
# Hostinger example: https://adreach-psi.vercel.app
# NEXT_PUBLIC_API_URL=

# CORS allowlist (origins only, no paths). Comma-separated.
# Production: https://adreach.agency
ALLOWED_ORIGINS=http://localhost:3000

# Set to "true" only when building the Hostinger static export (basePath /seminar)
# Leave unset/false for local and Vercel
# NEXT_STATIC=true
